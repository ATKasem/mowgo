# Copy to keystore.properties (SAME directory, gitignored) and fill in.
# Generate the keystore once with Android Studio:
#   Build → Generate Signed Bundle/APK → Create new keystore
#   (or: keytool -genkey -v -keystore mowgo-release.jks -alias mowgo -keyalg RSA -keysize 2048 -validity 10000)
# KEEP THIS FILE AND THE KEYSTORE SAFE — losing them means losing the ability to update the app.
storeFile=mowgo-release.jks
storePassword=CHANGE_ME
keyAlias=mowgo
keyPassword=CHANGE_ME
