{
  "appId": "com.mowgo.app",
  "appName": "MowGo",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#061208",
      "showSpinner": false,
      "androidSpinnerStyle": "small"
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#ffffff"
    }
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": true
  }
}
