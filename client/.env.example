VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:3001
# Set to 'true' to force demo mode even when Supabase is configured
# VITE_FORCE_DEMO=true

# --- Cloudflare Pages Function env vars (set in the Cloudflare dashboard, not here) ---
# SUPABASE_URL, SUPABASE_ANON_KEY  — required: /api/* authenticates the caller's
#                                    Supabase session before spending money or
#                                    returning customer data.
# OPENROUTER_API_KEY               — required for /api/autopilot
# STRIPE_SECRET_KEY                — required for /api/stripe/*
# ALLOWED_ORIGINS                  — optional comma-separated override; add
#                                    http://localhost:5173 for local dev.
