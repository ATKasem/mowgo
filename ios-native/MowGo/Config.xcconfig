// MowGo.xcconfig
// Xcode → Project → Info → Configurations → set for Debug & Release

// MARK: - Info.plist generation
INFOPLIST_KEY_CFBundleIdentifier = com.mowgo.app
INFOPLIST_KEY_CFBundleName = MowGo
INFOPLIST_KEY_CFBundleDisplayName = MowGo
INFOPLIST_KEY_CFBundleExecutable = MowGo
INFOPLIST_KEY_CFBundleShortVersionString = 1.0.0
INFOPLIST_KEY_CFBundleVersion = 1
INFOPLIST_KEY_UIRequiredDeviceCapabilities = arm64
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace = YES
INFOPLIST_KEY_NSCameraUsageDescription = MowGo uses your camera to attach photos to jobs.

// MARK: - Supabase
// _SLASH variable trick: xcconfig treats // as comment start, so we build
// the double-slash from two variable expansions. These values mirror the
// custom keys in Info.plist for build-setting visibility.
_SLASH = /
INFOPLIST_KEY_SUPABASE_URL = https:$(_SLASH)$(_SLASH)vqgiynfrpsqddjrayczc.supabase.co
INFOPLIST_KEY_SUPABASE_ANON_KEY = sb_publishable_C10u9M0wmcgAqDgkZoxm6g_eAsQSjpz

// MARK: - Stripe
INFOPLIST_KEY_StripePublishableKey = pk_live_51TwFQhGwXKVLlr2Ip5FKKwDmcwcOyG9lTFgOr2k3ooyaoLhYYwdfKQOOfzBnwcFpFgl8hAe9QHRR80Af1Odv6WEy00PnQgQarj

