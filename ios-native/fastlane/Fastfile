default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_FILEPATH"] || "~/.fastlane/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8",
      duration: 1200,
      in_house: false
    )

    sh("cd .. && xcodegen generate")

    # Pass the build number straight to xcodebuild. Info.plist reads
    # CFBundleVersion from $(CURRENT_PROJECT_VERSION); agvtool-based
    # increment_build_number needs VERSIONING_SYSTEM=apple-generic, which
    # this project doesn't set.
    build_number = latest_testflight_build_number(app_identifier: "com.mowgoapp") + 1

    build_app(
      project: "MowGo.xcodeproj",
      scheme: "MowGo",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
