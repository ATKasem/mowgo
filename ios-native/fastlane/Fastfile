default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_FILEPATH"] || "~/.fastlane/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8",
      duration: 1200,
      in_house: false
    )

    sh("cd .. && xcodegen generate")

    # Try to get the latest testflight build number, fall back to 0 if app doesn't exist yet
    begin
      latest = latest_testflight_build_number(app_identifier: "com.mowgo.app")
      increment_build_number(
        build_number: latest + 1,
        xcodeproj: "../MowGo.xcodeproj"
      )
    rescue => e
      puts "App not found - creating it now..."
      create_app_online(
        app_identifier: "com.mowgo.app",
        app_name: "MowGow",
        sku: "MowGow",
        company_name: "MowGo LLC",
        primary_language: "English (US)",
        software_url: "https://mowgoapp.com",
        platform: "ios"
      )
      increment_build_number(
        build_number: 1,
        xcodeproj: "../MowGo.xcodeproj"
      )
    end

    build_app(
      project: "../MowGo.xcodeproj",
      scheme: "MowGo",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end