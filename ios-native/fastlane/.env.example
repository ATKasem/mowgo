# MowGo Fastlane Environment Variables
# Copy to .env and fill in your values (never commit .env!)

# App Store Connect API Key
# Steps: https://appstoreconnect.apple.com → Users and Access → Integrations → App Store Connect API
APP_STORE_CONNECT_API_KEY_ID=ABC1234567
APP_STORE_CONNECT_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_API_KEY_FILEPATH=~/.fastlane/AuthKey_ABC1234567.p8

# Your Apple ID (email)
APPLE_ID=your@email.com
