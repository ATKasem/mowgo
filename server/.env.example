SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_role_key
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_CREW=price_...
STRIPE_PRICE_PREMIUM=price_...
# Annual-billing price IDs — required for checkout-subscription.js's
# interval=year path (functions/api/stripe/checkout-subscription.js) and for
# tierForSubscription in the Stripe webhook to recognize annual subscriptions.
# Must be set in the Cloudflare Pages dashboard (Settings > Environment
# variables) for BOTH Preview and Production — they are not read from this
# file in deployment. Missing one silently breaks annual checkout for that
# plan (checkout-subscription.js logs a warning and returns 500).
STRIPE_PRICE_SOLO_ANNUAL=price_...
STRIPE_PRICE_CREW_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
STRIPE_TRIAL_DAYS=14
RESEND_API_KEY=re_...
APP_URL=http://localhost:5173
PORT=3001
# Cloudflare Pages Function only: identify MowGo to api.weather.gov with a
# real monitored contact URL or email, per NWS API policy. Configure the real
# value in the Cloudflare dashboard. Example shape: App Name (monitored contact).
NWS_USER_AGENT=
