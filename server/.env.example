SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_role_key
# Payments (Cloudflare Pages Functions: functions/api/payments/*) run on Rise
# Concepts. Set in the Cloudflare Pages dashboard for BOTH Preview and
# Production. PAYMENTS_PROVIDER defaults to rise; until providers/rise.js is
# implemented, card UI shows "coming soon". See docs/PAYMENTS.md.
PAYMENTS_PROVIDER=
SUBSCRIPTION_TRIAL_DAYS=14
# Rise Concepts / MX Merchant (used once providers/rise.js is implemented)
RISE_API_BASE_URL=
RISE_API_KEY=
RISE_API_SECRET=
RISE_PLATFORM_MERCHANT_ID=
RISE_WEBHOOK_SECRET=
RISE_HOSTED_PAGE_HOSTS=
RESEND_API_KEY=re_...
APP_URL=http://localhost:5173
PORT=3001
# Cloudflare Pages Function only: identify MowGo to api.weather.gov with a
# real monitored contact URL or email, per NWS API policy. Configure the real
# value in the Cloudflare dashboard. Example shape: App Name (monitored contact).
NWS_USER_AGENT=
